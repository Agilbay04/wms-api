# Copy to .env, then set SPRING_PROFILES_ACTIVE to dev, stg, or prod.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL on HomeServer
# Hostname or IP address of the PostgreSQL server.
WMS_DB_HOST=
WMS_DB_PORT=5432
WMS_DB_NAME=wms
WMS_DB_USERNAME=
WMS_DB_PASSWORD=
# HikariCP connection-pool settings.
WMS_DB_POOL_SIZE=10
WMS_DB_CONNECTION_TIMEOUT_MS=30000

# Redis on HomeServer
WMS_REDIS_HOST=
WMS_REDIS_PORT=6379
WMS_REDIS_PASSWORD=
# TTL for Redis-backed application caches.
WMS_CACHE_TTL=10m

# Mailpit SMTP on HomeServer
WMS_MAIL_HOST=
WMS_MAIL_PORT=1025
WMS_MAIL_USERNAME=
WMS_MAIL_PASSWORD=
WMS_MAIL_SMTP_AUTH=false
WMS_MAIL_SMTP_STARTTLS=false

# HTTP port for this API. Use a different value if 8081 is occupied.
WMS_SERVER_PORT=8081

# Use a random secret of at least 32 bytes. Never commit it.
# Quote values containing spaces, #, $, !, or other shell-special characters.
WMS_JWT_SECRET=
WMS_JWT_ACCESS_TOKEN_TTL=15m
WMS_JWT_REFRESH_TOKEN_TTL=7d

# Used only by the dev profile.
WMS_SEED_ADMIN_EMAIL=
WMS_SEED_ADMIN_NAME=
WMS_SEED_ADMIN_PASSWORD=

# Allow the dev-only master-data seeder to write to the configured database.
# Keep false until you have verified the target database.
SEEDER_ENABLE_DB_SETUP=false
WMS_SEED_RESULT_DIRECTORY=seed-results

# Directory relative to the application working directory, or an absolute path.
WMS_EXPORT_DIRECTORY=exports
