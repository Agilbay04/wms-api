Project warehouse_management {
  database_type: 'PostgreSQL'
  Note: 'Warehouse Management database schema'
}

// IAM (Identity & Access Management)

Table operations {
  id uuid [pk, not null]
  name varchar [not null, unique] // create, read, update, delete, approve, reject, export
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table resources {
  id uuid [pk, not null]
  name varchar [not null, unique] // products, warehouses, inbounds, outbounds, stock_transfers, stock_adjustments, reports
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table permissions {
  id uuid [pk, not null]
  operation_id uuid [not null, ref: > operations.id]
  resource_id uuid [not null, ref: > resources.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    operation_id
    resource_id
    (operation_id, resource_id) [unique]
  }
}

Table roles {
  id uuid [pk, not null]
  name varchar [not null, unique] // superadmin, supervisor, staff
  description text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp
}

Table role_permissions {
  id uuid [pk, not null]
  role_id uuid [not null, ref: > roles.id]
  permission_id uuid [not null, ref: > permissions.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    role_id
    permission_id
    (role_id, permission_id) [unique]
  }
}

Table users {
  id uuid [pk, not null]
  email varchar [not null, unique]
  name varchar [not null]
  password varchar [not null]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    email
  }
}

Table user_roles {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  role_id uuid [not null, ref: > roles.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    user_id
    role_id
    (user_id, role_id) [unique]
  }
}

// Master Data

Table product_categories {
  id uuid [pk, not null]
  code varchar [not null, unique]
  name varchar [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    code
  }
}

Table products {
  id uuid [pk, not null]
  product_category_id uuid [not null, ref: > product_categories.id]
  sku varchar [not null, unique]
  name varchar [not null]
  description text
  unit varchar [not null] // pcs, box, kg, liter
  minimum_stock int [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    product_category_id
    sku
    name
  }
}

Table warehouses {
  id uuid [pk, not null]
  code varchar [not null, unique]
  name varchar [not null]
  address text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    code
    name
  }
}

Table warehouse_locations {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  code varchar [not null]
  name varchar [not null]
  description text
  is_active boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    (warehouse_id, code) [unique]
  }
}

Table user_warehouses {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  warehouse_id uuid [not null, ref: > warehouses.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    user_id
    warehouse_id
    (user_id, warehouse_id) [unique]
  }
}

// Inbound

Table inbounds {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  reference_number varchar [not null, unique]
  purchase_order_number varchar
  status varchar [not null] // pending, approved, rejected
  notes text
  rejection_note text
  submitted_at timestamp
  reviewed_at timestamp
  created_by_user_id uuid [not null, ref: > users.id]
  reviewed_by_user_id uuid [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    created_by_user_id
    reviewed_by_user_id
    reference_number
    (warehouse_id, status)
    created_at
  }
}

Table inbound_items {
  id uuid [pk, not null]
  inbound_id uuid [not null, ref: > inbounds.id]
  product_id uuid [not null, ref: > products.id]
  quantity int [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    inbound_id
    product_id
    (inbound_id, product_id)
  }
}

// Outbound

Table outbounds {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  reference_number varchar [not null, unique]
  status varchar [not null] // pending, approved, rejected
  notes text
  rejection_note text
  submitted_at timestamp
  reviewed_at timestamp
  created_by_user_id uuid [not null, ref: > users.id]
  reviewed_by_user_id uuid [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    created_by_user_id
    reviewed_by_user_id
    reference_number
    (warehouse_id, status)
    created_at
  }
}

Table outbound_items {
  id uuid [pk, not null]
  outbound_id uuid [not null, ref: > outbounds.id]
  product_id uuid [not null, ref: > products.id]
  warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  quantity int [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    outbound_id
    product_id
    warehouse_location_id
    (outbound_id, product_id)
  }
}

// Inventory

Table stock_transfers {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  reference_number varchar [not null, unique]
  status varchar [not null] // pending, approved, rejected
  notes text
  rejection_note text
  submitted_at timestamp
  reviewed_at timestamp
  created_by_user_id uuid [not null, ref: > users.id]
  reviewed_by_user_id uuid [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    created_by_user_id
    reviewed_by_user_id
    reference_number
    (warehouse_id, status)
    created_at
  }
}

Table stock_transfer_items {
  id uuid [pk, not null]
  stock_transfer_id uuid [not null, ref: > stock_transfers.id]
  product_id uuid [not null, ref: > products.id]
  source_warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  destination_warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  quantity int [not null]
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    stock_transfer_id
    product_id
    source_warehouse_location_id
    destination_warehouse_location_id
    (stock_transfer_id, product_id)
  }
}

Table stock_adjustments {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  reference_number varchar [not null, unique]
  status varchar [not null] // pending, approved, rejected
  adjustment_type varchar [not null] // stock_opname, damaged_goods, lost_goods, correction
  reason text [not null]
  rejection_note text
  submitted_at timestamp
  reviewed_at timestamp
  created_by_user_id uuid [not null, ref: > users.id]
  reviewed_by_user_id uuid [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    created_by_user_id
    reviewed_by_user_id
    reference_number
    (warehouse_id, status)
    (warehouse_id, adjustment_type)
    created_at
  }
}

Table stock_adjustment_items {
  id uuid [pk, not null]
  stock_adjustment_id uuid [not null, ref: > stock_adjustments.id]
  product_id uuid [not null, ref: > products.id]
  warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  quantity_change int [not null] // positive adds stock, negative reduces stock
  notes text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    stock_adjustment_id
    product_id
    warehouse_location_id
    (stock_adjustment_id, product_id)
  }
}

Table warehouse_location_items {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  product_id uuid [not null, ref: > products.id]
  quantity int [not null, default: 0]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    warehouse_location_id
    product_id
    (warehouse_id, product_id)
    (warehouse_location_id, product_id) [unique]
  }
}

Table stock_movements {
  id uuid [pk, not null]
  warehouse_id uuid [not null, ref: > warehouses.id]
  warehouse_location_id uuid [not null, ref: > warehouse_locations.id]
  product_id uuid [not null, ref: > products.id]
  movement_type varchar [not null] // inbound, outbound, stock_transfer, stock_adjustment
  movement_direction varchar [not null] // in, out
  quantity int [not null]
  stock_after int [not null]
  source_entity_type varchar [not null] // inbound, outbound, stock_transfer, stock_adjustment
  source_entity_id uuid [not null]
  source_item_id uuid // inbound_items, outbound_items, stock_transfer_items, or stock_adjustment_items id
  occurred_at timestamp [not null, default: `now()`]
  created_by_user_id uuid [not null, ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    warehouse_id
    warehouse_location_id
    product_id
    created_by_user_id
    (warehouse_id, product_id, occurred_at)
    (warehouse_location_id, product_id, occurred_at)
    (source_entity_type, source_entity_id)
    occurred_at
  }
}

// Supporting

Table audit_trails {
  id uuid [pk, not null]
  user_id uuid [not null, ref: > users.id]
  action varchar [not null] // create, update, delete, request_approval, approve, reject, export
  entity_type varchar [not null] // warehouse, product, inbound, outbound, stock_transfer, stock_adjustment, stock_movement
  entity_id uuid [not null]
  description text
  occurred_at timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Indexes {
    user_id
    (entity_type, entity_id)
    action
    occurred_at
  }
}
